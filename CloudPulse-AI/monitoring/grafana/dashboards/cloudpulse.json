{
  "uid": "cloudpulse-local",
  "title": "CloudPulse AI | Historical Replay and API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Simulated windows",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 6,
        "x": 0,
        "y": 0,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudpulse_replay_windows",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Simulated alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 6,
        "x": 6,
        "y": 0,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudpulse_replay_alerts",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Median replay latency",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 6,
        "x": 12,
        "y": 0,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudpulse_replay_median_latency_seconds",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Offline test ROC AUC",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 6,
        "x": 18,
        "y": 0,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudpulse_offline_roc_auc",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "API predictions by alert decision",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 12,
        "x": 0,
        "y": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alert) (rate(cloudpulse_predictions_total[1m]))",
          "legendFormat": "{{alert}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "API latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 12,
        "x": 12,
        "y": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloudpulse_inference_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Top-ranked service deviations by scenario",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudpulse-prometheus"
      },
      "gridPos": {
        "w": 24,
        "x": 0,
        "y": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudpulse_investigation_top_rank",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ]
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  }
}